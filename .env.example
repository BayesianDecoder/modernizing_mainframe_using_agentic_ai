# Chat runs on Gemini (see backend/claude_brain.py) — a free key works at
# https://aistudio.google.com, though the free tier's request quota is tight
# and varies by model; see README.md's "known limitation" note.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-flash-lite-latest

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password

# Optional — enables tracing at smith.langchain.com
LANGSMITH_API_KEY=ls__optional
LANGSMITH_PROJECT=MAIA-Live
LANGSMITH_TRACING=true
